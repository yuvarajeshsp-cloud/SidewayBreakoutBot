// Range detection block is adapted from LuxAlgo's "Range Detector"
// Licensed under CC BY-NC-SA 4.0: https://creativecommons.org/licenses/by-nc-sa/4.0/
// © LuxAlgo
//@version=6
indicator("Sideway Breakout Bot [Indicator]", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ───────────────────────────── Inputs ─────────────────────────────
grpRange = "Range Detector"
rangeLength = input.int(20, "Minimum Range Length", minval=2, group=grpRange)
rangeMult   = input.float(1.0, "Range Width", minval=0, step=0.1, group=grpRange)
rangeAtrLen = input.int(500, "Range ATR Length", minval=1, group=grpRange)
upCss       = input.color(#089981, "Broken Upward", group=grpRange)
dnCss       = input.color(#f23645, "Broken Downward", group=grpRange)
unbrokenCss = input.color(#2157f3, "Unbroken", group=grpRange)
maxBarsWatch = input.int(50, "Max Bars to Wait for Breakout", minval=1, group=grpRange)

grpBreak = "Breakout"
atrLength     = input.int(14, "ATR Length (SL/Filters)", minval=1, group=grpBreak)
useBodyFilter = input.bool(false, "Require Min Body Size", group=grpBreak)
bodyATRMult   = input.float(0.5, "Min Body Size (x ATR)", minval=0, group=grpBreak)

grpZone = "Retracement Zone"
zoneScanMaxBars = input.int(15, "Zone Scan Lookback (bars)", minval=3, group=grpZone)
fvgMinATRMult   = input.float(0.0, "Min FVG Size (x ATR)", minval=0, group=grpZone)
maxBarsRetrace  = input.int(30, "Max Bars to Wait for Confirmation", minval=1, group=grpZone)

grpRisk = "Risk Management"
slBufferATRMult = input.float(0.1, "SL Buffer (x ATR)", minval=0, group=grpRisk)

grpTP = "Take Profit"
tp1R = input.float(1.0, "TP1 (R multiple)", minval=0.1, group=grpTP)
tp2R = input.float(2.0, "TP2 (R multiple)", minval=0.1, group=grpTP)
tp3R = input.float(3.0, "TP3 (R multiple)", minval=0.1, group=grpTP)

grpVis = "Visuals"
showLabels = input.bool(true, "Show Entry Labels", group=grpVis)

// ───────────────────────────── Range Detector (LuxAlgo) ─────────────────────────────
var box   bx   = na
var line  lvl  = na
var float rMax = na
var float rMin = na
var int   rOs  = 0
color detect_css = na

n = bar_index
rAtr = ta.atr(rangeAtrLen) * rangeMult
ma = ta.sma(close, rangeLength)

rCount = 0
for i = 0 to rangeLength - 1
    rCount += math.abs(close[i] - ma) > rAtr ? 1 : 0

rangeEvent = rCount == 0 and rCount[1] != rCount

if rangeEvent
    if n[rangeLength] <= bx.get_right()
        rMax := math.max(ma + rAtr, bx.get_top())
        rMin := math.min(ma - rAtr, bx.get_bottom())
        bx.set_top(rMax)
        bx.set_rightbottom(n, rMin)
        bx.set_bgcolor(color.new(unbrokenCss, 80))
        avg = math.avg(rMax, rMin)
        lvl.set_y1(avg)
        lvl.set_xy2(n, avg)
        lvl.set_color(unbrokenCss)
    else
        rMax := ma + rAtr
        rMin := ma - rAtr
        bx := box.new(n[rangeLength], ma + rAtr, n, ma - rAtr, na, bgcolor=color.new(unbrokenCss, 80))
        lvl := line.new(n[rangeLength], ma, n, ma, color=unbrokenCss, style=line.style_dotted)
        detect_css := color.new(color.gray, 80)
        rOs := 0
else if rCount == 0
    bx.set_right(n)
    lvl.set_x2(n)

if close > bx.get_top()
    bx.set_bgcolor(color.new(upCss, 80))
    lvl.set_color(upCss)
    rOs := 1
else if close < bx.get_bottom()
    bx.set_bgcolor(color.new(dnCss, 80))
    lvl.set_color(dnCss)
    rOs := -1

bgcolor(detect_css)
plot(rMax, "Range Top", rMax != rMax[1] ? na : rOs == 0 ? unbrokenCss : rOs == 1 ? upCss : dnCss)
plot(rMin, "Range Bottom", rMin != rMin[1] ? na : rOs == 0 ? unbrokenCss : rOs == 1 ? upCss : dnCss)

// ───────────────────────────── Core calcs ─────────────────────────────
atrVal = ta.atr(atrLength)

// ───────────────────────────── State machine ─────────────────────────────
// 0 = idle, 1 = range locked/watching breakout, 2 = waiting for confirmation, 3 = hypothetical open trade
var int   state       = 0
var float lockedHigh  = na
var float lockedLow   = na
var int   lockBar     = na
var int   dir         = 0
var int   breakoutBar = na
var float zoneHigh    = na
var float zoneLow     = na
var float zoneMid     = na
var bool  touchedZone = false
var float slPrice     = na
var float entryPrice  = na
var float tp1Price    = na
var float tp2Price    = na
var float tp3Price    = na
var bool  tp1Hit      = false
var bool  tp2Hit      = false
var bool  tp3Hit      = false
bool entrySignal = false
bool exitSignal  = false
bool isLongEntry = false
bool isShortEntry = false

// ---- State 3: track hypothetical open trade for alerts, no real position ----
if state == 3
    currentStop = tp1Hit ? entryPrice : slPrice
    stopHit = dir == 1 ? low <= currentStop : high >= currentStop
    if not tp1Hit and (dir == 1 ? high >= tp1Price : low <= tp1Price)
        tp1Hit := true
        alert("Sideway Breakout Bot: TP1 hit, SL moved to breakeven", alert.freq_once_per_bar_close)
    if tp1Hit and not tp2Hit and (dir == 1 ? high >= tp2Price : low <= tp2Price)
        tp2Hit := true
        alert("Sideway Breakout Bot: TP2 hit", alert.freq_once_per_bar_close)
    if tp2Hit and not tp3Hit and (dir == 1 ? high >= tp3Price : low <= tp3Price)
        tp3Hit := true
        alert("Sideway Breakout Bot: TP3 hit, trade closed", alert.freq_once_per_bar_close)

    if stopHit or tp3Hit
        exitSignal := true
        state := 0
        lockedHigh := na
        lockedLow := na
        lockBar := na
        dir := 0
        breakoutBar := na
        zoneHigh := na
        zoneLow := na
        zoneMid := na
        touchedZone := false
        slPrice := na
        entryPrice := na
        tp1Price := na
        tp2Price := na
        tp3Price := na
        tp1Hit := false
        tp2Hit := false
        tp3Hit := false

// ---- Arm/refresh watch whenever the range detector (re)confirms a range ----
if rangeEvent and (state == 0 or state == 1)
    lockedHigh := rMax
    lockedLow := rMin
    lockBar := n
    state := 1

// ---- State 1: watch for full-body breakout ----
if state == 1
    bodySize = math.abs(close - open)
    passesBody = not useBodyFilter or bodySize >= bodyATRMult * atrVal
    bullBreak = math.min(open, close) > lockedHigh and passesBody
    bearBreak = math.max(open, close) < lockedLow and passesBody

    if bullBreak or bearBreak
        dir := bullBreak ? 1 : -1
        breakoutBar := bar_index

        scanLen = math.min(bar_index - lockBar, zoneScanMaxBars)
        var float fZoneHigh = na
        var float fZoneLow = na
        fZoneHigh := na
        fZoneLow := na
        bool fvgFound = false
        bool breakerFound = false

        if scanLen >= 3
            for i = 1 to scanLen - 2
                if not fvgFound
                    if dir == 1
                        if low[i] > high[i + 2] and (low[i] - high[i + 2]) >= fvgMinATRMult * atrVal
                            fZoneLow := high[i + 2]
                            fZoneHigh := low[i]
                            fvgFound := true
                    else
                        if high[i] < low[i + 2] and (high[i + 2] - high[i]) >= fvgMinATRMult * atrVal
                            fZoneHigh := low[i + 2]
                            fZoneLow := high[i]
                            fvgFound := true
                    if fvgFound
                        break

        if not fvgFound and scanLen >= 2
            for i = 1 to scanLen - 1
                if not breakerFound
                    isOpposite = dir == 1 ? close[i] < open[i] : close[i] > open[i]
                    if isOpposite
                        fZoneHigh := high[i]
                        fZoneLow := low[i]
                        breakerFound := true
                    if breakerFound
                        break

        if not fvgFound and not breakerFound
            if dir == 1
                fZoneLow := lockedHigh
                fZoneHigh := ta.highest(high, math.max(scanLen, 1))
            else
                fZoneHigh := lockedLow
                fZoneLow := ta.lowest(low, math.max(scanLen, 1))

        zoneHigh := fZoneHigh
        zoneLow := fZoneLow
        zoneMid := (fZoneHigh + fZoneLow) / 2
        touchedZone := false
        state := 2

        alert("Sideway Breakout Bot: " + (dir == 1 ? "bullish" : "bearish") + " breakout confirmed, zone identified", alert.freq_once_per_bar_close)

    else if bar_index - lockBar > maxBarsWatch
        state := 0
        lockedHigh := na
        lockedLow := na
        lockBar := na
        dir := 0
        breakoutBar := na
        zoneHigh := na
        zoneLow := na
        zoneMid := na
        touchedZone := false
        slPrice := na
        entryPrice := na
        tp1Price := na
        tp2Price := na
        tp3Price := na
        tp1Hit := false
        tp2Hit := false
        tp3Hit := false

// ---- State 2: wait for retracement + confirmation candle ----
if state == 2
    touched = dir == 1 ? low <= zoneMid : high >= zoneMid
    if touched
        touchedZone := true

    confirmBull = close > open and close > zoneMid
    confirmBear = close < open and close < zoneMid
    confirmation = touchedZone and (dir == 1 ? confirmBull : confirmBear)

    invalidated = dir == 1 ? close < lockedLow : close > lockedHigh
    barsSinceBreakout = bar_index - breakoutBar

    if confirmation
        entryPrice := close
        buffer = slBufferATRMult * atrVal
        slPrice := dir == 1 ? lockedLow - buffer : lockedHigh + buffer
        r = math.abs(entryPrice - slPrice)
        tp1Price := dir == 1 ? entryPrice + r * tp1R : entryPrice - r * tp1R
        tp2Price := dir == 1 ? entryPrice + r * tp2R : entryPrice - r * tp2R
        tp3Price := dir == 1 ? entryPrice + r * tp3R : entryPrice - r * tp3R

        state := 3
        entrySignal := true
        isLongEntry := dir == 1
        isShortEntry := dir == -1
        if showLabels
            if dir == 1
                label.new(bar_index, low, "LONG", style=label.style_label_up, color=color.green, textcolor=color.white, yloc=yloc.belowbar)
            else
                label.new(bar_index, high, "SHORT", style=label.style_label_down, color=color.red, textcolor=color.white, yloc=yloc.abovebar)
        alert("Sideway Breakout Bot: " + (dir == 1 ? "LONG" : "SHORT") + " entry signal", alert.freq_once_per_bar_close)

    else if invalidated or barsSinceBreakout > maxBarsRetrace
        state := 0
        lockedHigh := na
        lockedLow := na
        lockBar := na
        dir := 0
        breakoutBar := na
        zoneHigh := na
        zoneLow := na
        zoneMid := na
        touchedZone := false
        slPrice := na
        entryPrice := na
        tp1Price := na
        tp2Price := na
        tp3Price := na
        tp1Hit := false
        tp2Hit := false
        tp3Hit := false

// ───────────────────────────── Plots / signals ─────────────────────────────
plotshape(isLongEntry, "Long Entry", shape.triangleup, location.belowbar, color.green, size=size.small)
plotshape(isShortEntry, "Short Entry", shape.triangledown, location.abovebar, color.red, size=size.small)
plotshape(exitSignal, "Trade Closed", shape.xcross, location.abovebar, color.gray, size=size.tiny)

alertcondition(isLongEntry, "Long Entry Signal", "Sideway Breakout Bot: LONG entry signal")
alertcondition(isShortEntry, "Short Entry Signal", "Sideway Breakout Bot: SHORT entry signal")
alertcondition(exitSignal, "Trade Closed", "Sideway Breakout Bot: trade closed (SL or TP3)")
