// Range detection block is adapted from LuxAlgo's "Range Detector"
// Licensed under CC BY-NC-SA 4.0: https://creativecommons.org/licenses/by-nc-sa/4.0/
// © LuxAlgo
//@version=6
strategy("Sideway Breakout Bot [Strategy]", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, calc_on_every_tick=false, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ───────────────────────────── Inputs ─────────────────────────────
grpRange = "Range Detector"
rangeLength = input.int(10, "Minimum Range Length", minval=2, group=grpRange)
rangeMult   = input.float(1.5, "Range Width", minval=0, step=0.1, group=grpRange)
rangeAtrLen = input.int(100, "Range ATR Length", minval=1, group=grpRange)
upCss       = input.color(#089981, "Broken Upward", group=grpRange)
dnCss       = input.color(#f23645, "Broken Downward", group=grpRange)
unbrokenCss = input.color(#2157f3, "Unbroken", group=grpRange)
maxBarsWatch = input.int(50, "Max Bars to Wait for Breakout", minval=1, group=grpRange)

grpBreak = "Breakout"
atrLength         = input.int(14, "ATR Length (SL/Filters)", minval=1, group=grpBreak)
useBodyFilter     = input.bool(false, "Require Min Body Size", group=grpBreak)
bodyATRMult       = input.float(0.5, "Min Body Size (x ATR)", minval=0, group=grpBreak)
useFakeoutFilter  = input.bool(true, "Require Confirmation Candle After Breakout", group=grpBreak)

grpZone = "Retracement Zone"
zoneScanMaxBars  = input.int(15, "Zone Scan Lookback (bars)", minval=3, group=grpZone)
fvgMinATRMult    = input.float(0.0, "Min FVG Size (x ATR)", minval=0, group=grpZone)
retraceTimeoutMin = input.int(30, "Retracement Timeout (minutes)", minval=1, group=grpZone)

grpRisk = "Risk Management"
riskPercent     = input.float(1.0, "Risk % per Trade", minval=0.01, group=grpRisk)
slBufferATRMult = input.float(0.1, "SL Buffer (x ATR)", minval=0, group=grpRisk)

grpTP = "Take Profit"
tp1R = input.float(1.0, "TP1 (R multiple)", minval=0.1, group=grpTP)
tp2R = input.float(2.0, "TP2 (R multiple)", minval=0.1, group=grpTP)
tp3R = input.float(3.0, "TP3 (R multiple)", minval=0.1, group=grpTP)
tp1Qty = input.float(33, "TP1 Close %", minval=1, maxval=100, group=grpTP)
tp2Qty = input.float(33, "TP2 Close %", minval=1, maxval=100, group=grpTP)
tp3Qty = input.float(34, "TP3 Close %", minval=1, maxval=100, group=grpTP)
moveToBEAfterTP1 = input.bool(true, "Move SL to Breakeven after TP1", group=grpTP)

grpVis = "Visuals"
showZone   = input.bool(true, "Show Retracement Zone", group=grpVis)
showLevels = input.bool(true, "Show Entry/SL/TP Levels", group=grpVis)

// ───────────────────────────── Range Detector (LuxAlgo) ─────────────────────────────
var box   bx   = na
var line  lvl  = na
var float rMax = na
var float rMin = na
var int   rOs  = 0
color detect_css = na

n = bar_index
rAtr = ta.atr(rangeAtrLen) * rangeMult
ma = ta.sma(close, rangeLength)

rCount = 0
for i = 0 to rangeLength - 1
    rCount += math.abs(close[i] - ma) > rAtr ? 1 : 0

rangeEvent = rCount == 0 and rCount[1] != rCount

if rangeEvent
    if n[rangeLength] <= bx.get_right()
        rMax := math.max(ma + rAtr, bx.get_top())
        rMin := math.min(ma - rAtr, bx.get_bottom())
        bx.set_top(rMax)
        bx.set_rightbottom(n, rMin)
        bx.set_bgcolor(color.new(unbrokenCss, 80))
        avg = math.avg(rMax, rMin)
        lvl.set_y1(avg)
        lvl.set_xy2(n, avg)
        lvl.set_color(unbrokenCss)
    else
        rMax := ma + rAtr
        rMin := ma - rAtr
        bx := box.new(n[rangeLength], ma + rAtr, n, ma - rAtr, na, bgcolor=color.new(unbrokenCss, 80))
        lvl := line.new(n[rangeLength], ma, n, ma, color=unbrokenCss, style=line.style_dotted)
        detect_css := color.new(color.gray, 80)
        rOs := 0
else if rCount == 0
    bx.set_right(n)
    lvl.set_x2(n)

if close > bx.get_top()
    bx.set_bgcolor(color.new(upCss, 80))
    lvl.set_color(upCss)
    rOs := 1
else if close < bx.get_bottom()
    bx.set_bgcolor(color.new(dnCss, 80))
    lvl.set_color(dnCss)
    rOs := -1

bgcolor(detect_css)
plot(rMax, "Range Top", rMax != rMax[1] ? na : rOs == 0 ? unbrokenCss : rOs == 1 ? upCss : dnCss)
plot(rMin, "Range Bottom", rMin != rMin[1] ? na : rOs == 0 ? unbrokenCss : rOs == 1 ? upCss : dnCss)

// ───────────────────────────── Core calcs ─────────────────────────────
atrVal = ta.atr(atrLength)

// Scans the breakout leg for the nearest FVG, else a breaker candle, else falls
// back to a leg retracement. Returns [zoneHigh, zoneLow]. Read-only over outer
// state (lockBar, lockedHigh, lockedLow, atrVal) so it stays a plain function.
f_findZone(d, lockBarArg, lockedHighArg, lockedLowArg) =>
    scanLen = math.min(bar_index - lockBarArg, zoneScanMaxBars)
    float fH = na
    float fL = na
    bool fvgFound = false
    bool breakerFound = false

    if scanLen >= 3
        for i = 1 to scanLen - 2
            if not fvgFound
                if d == 1
                    if low[i] > high[i + 2] and (low[i] - high[i + 2]) >= fvgMinATRMult * atrVal
                        fL := high[i + 2]
                        fH := low[i]
                        fvgFound := true
                else
                    if high[i] < low[i + 2] and (high[i + 2] - high[i]) >= fvgMinATRMult * atrVal
                        fH := low[i + 2]
                        fL := high[i]
                        fvgFound := true
                if fvgFound
                    break

    if not fvgFound and scanLen >= 2
        for i = 1 to scanLen - 1
            if not breakerFound
                isOpposite = d == 1 ? close[i] < open[i] : close[i] > open[i]
                if isOpposite
                    fH := high[i]
                    fL := low[i]
                    breakerFound := true
                if breakerFound
                    break

    if not fvgFound and not breakerFound
        if d == 1
            fL := lockedHighArg
            fH := ta.highest(high, math.max(scanLen, 1))
        else
            fH := lockedLowArg
            fL := ta.lowest(low, math.max(scanLen, 1))

    [fH, fL]

// ───────────────────────────── State machine ─────────────────────────────
// 0 = idle, 1 = watching for breakout, 4 = awaiting confirmation candle (fakeout filter),
// 2 = waiting for retracement confirmation, 3 = in trade
var int   state       = 0
var float lockedHigh  = na
var float lockedLow   = na
var int   lockBar     = na
var int   dir         = 0
var int   breakoutTime = na
var float zoneHigh    = na
var float zoneLow     = na
var float zoneMid     = na
var bool  touchedZone = false
var float slPrice     = na
var float entryPrice  = na
var float tp1Price    = na
var float tp2Price    = na
var float tp3Price    = na
var bool  tp1Filled   = false
var float qtyAtEntry  = na
var box   zoneBox     = na
var line  slLine      = na
var line  tp1Line     = na
var line  tp2Line     = na
var line  tp3Line     = na

// ---- State 3: manage open trade / detect close ----
if state == 3 and strategy.position_size == 0
    if not na(zoneBox)
        box.delete(zoneBox)
    state := 0
    lockedHigh := na
    lockedLow := na
    lockBar := na
    dir := 0
    breakoutTime := na
    zoneHigh := na
    zoneLow := na
    zoneMid := na
    touchedZone := false
    slPrice := na
    entryPrice := na
    tp1Price := na
    tp2Price := na
    tp3Price := na
    tp1Filled := false
    qtyAtEntry := na

if state == 3 and strategy.position_size != 0
    if na(qtyAtEntry)
        qtyAtEntry := math.abs(strategy.position_size)
    if not tp1Filled and math.abs(strategy.position_size) <= qtyAtEntry * (1 - tp1Qty / 100) + 1e-8
        tp1Filled := true
        alert("Sideway Breakout Bot: TP1 hit, SL moved to breakeven", alert.freq_once_per_bar_close)

    currentStop = moveToBEAfterTP1 and tp1Filled ? entryPrice : slPrice
    if dir == 1
        strategy.exit("TP1", from_entry="Long", qty_percent=tp1Qty, limit=tp1Price, stop=currentStop)
        strategy.exit("TP2", from_entry="Long", qty_percent=tp2Qty, limit=tp2Price, stop=currentStop)
        strategy.exit("TP3", from_entry="Long", qty_percent=tp3Qty, limit=tp3Price, stop=currentStop)
    else
        strategy.exit("TP1", from_entry="Short", qty_percent=tp1Qty, limit=tp1Price, stop=currentStop)
        strategy.exit("TP2", from_entry="Short", qty_percent=tp2Qty, limit=tp2Price, stop=currentStop)
        strategy.exit("TP3", from_entry="Short", qty_percent=tp3Qty, limit=tp3Price, stop=currentStop)

    if showLevels and not na(slLine)
        line.set_y1(slLine, currentStop)
        line.set_y2(slLine, currentStop)

// ---- Arm/refresh watch whenever the range detector (re)confirms a range ----
if rangeEvent and (state == 0 or state == 1)
    lockedHigh := rMax
    lockedLow := rMin
    lockBar := n
    state := 1

// ---- State 1: watch for full-body breakout ----
if state == 1
    bodySize = math.abs(close - open)
    passesBody = not useBodyFilter or bodySize >= bodyATRMult * atrVal
    bullBreak = math.min(open, close) > lockedHigh and passesBody
    bearBreak = math.max(open, close) < lockedLow and passesBody

    if bullBreak or bearBreak
        dir := bullBreak ? 1 : -1
        breakoutTime := time

        if useFakeoutFilter
            state := 4
            alert("Sideway Breakout Bot: " + (bullBreak ? "bullish" : "bearish") + " breakout, awaiting confirmation candle", alert.freq_once_per_bar_close)
        else
            [zH, zL] = f_findZone(dir, lockBar, lockedHigh, lockedLow)
            zoneHigh := zH
            zoneLow := zL
            zoneMid := (zH + zL) / 2
            touchedZone := false
            state := 2
            if showZone
                zoneBox := box.new(bar_index, zoneHigh, bar_index, zoneLow, border_color=color.orange, bgcolor=color.new(color.orange, 85))
            alert("Sideway Breakout Bot: " + (dir == 1 ? "bullish" : "bearish") + " breakout confirmed, zone identified", alert.freq_once_per_bar_close)

    else if bar_index - lockBar > maxBarsWatch
        state := 0
        lockedHigh := na
        lockedLow := na
        lockBar := na
        dir := 0
        breakoutTime := na
        zoneHigh := na
        zoneLow := na
        zoneMid := na
        touchedZone := false
        slPrice := na
        entryPrice := na
        tp1Price := na
        tp2Price := na
        tp3Price := na
        tp1Filled := false
        qtyAtEntry := na

// ---- State 4: require the next candle to close entirely away from the range
// too (fakeout filter) before hunting for a retracement zone ----
if state == 4
    bodySize4 = math.abs(close - open)
    passesBody4 = not useBodyFilter or bodySize4 >= bodyATRMult * atrVal
    confirmed = dir == 1 ? math.min(open, close) > lockedHigh and passesBody4 : math.max(open, close) < lockedLow and passesBody4

    if confirmed
        breakoutTime := time
        [zH, zL] = f_findZone(dir, lockBar, lockedHigh, lockedLow)
        zoneHigh := zH
        zoneLow := zL
        zoneMid := (zH + zL) / 2
        touchedZone := false
        state := 2
        if showZone
            zoneBox := box.new(bar_index, zoneHigh, bar_index, zoneLow, border_color=color.orange, bgcolor=color.new(color.orange, 85))
        alert("Sideway Breakout Bot: " + (dir == 1 ? "bullish" : "bearish") + " breakout confirmed, zone identified", alert.freq_once_per_bar_close)
    else
        dir := 0
        breakoutTime := na
        state := 1
        alert("Sideway Breakout Bot: breakout failed confirmation (fakeout), watching for a new breakout", alert.freq_once_per_bar_close)

// ---- State 2: wait for retracement + confirmation candle ----
if state == 2
    if showZone and not na(zoneBox)
        box.set_right(zoneBox, bar_index)

    touched = dir == 1 ? low <= zoneMid : high >= zoneMid
    if touched
        touchedZone := true

    confirmBull = close > open and close > zoneMid
    confirmBear = close < open and close < zoneMid
    confirmation = touchedZone and (dir == 1 ? confirmBull : confirmBear)

    invalidated = dir == 1 ? close < lockedLow : close > lockedHigh
    minutesSinceBreakout = (time - breakoutTime) / 60000.0

    if confirmation
        entryPrice := close
        buffer = slBufferATRMult * atrVal
        slPrice := dir == 1 ? lockedLow - buffer : lockedHigh + buffer
        r = math.abs(entryPrice - slPrice)
        tp1Price := dir == 1 ? entryPrice + r * tp1R : entryPrice - r * tp1R
        tp2Price := dir == 1 ? entryPrice + r * tp2R : entryPrice - r * tp2R
        tp3Price := dir == 1 ? entryPrice + r * tp3R : entryPrice - r * tp3R

        riskAmount = strategy.equity * (riskPercent / 100)
        qtyToTrade = r > 0 ? riskAmount / (r * syminfo.pointvalue) : 0.0

        if qtyToTrade > 0
            if dir == 1
                strategy.entry("Long", strategy.long, qty=qtyToTrade)
                label.new(bar_index, low, "LONG ENTRY", style=label.style_label_up, color=color.green, textcolor=color.white, yloc=yloc.belowbar)
            else
                strategy.entry("Short", strategy.short, qty=qtyToTrade)
                label.new(bar_index, high, "SHORT ENTRY", style=label.style_label_down, color=color.red, textcolor=color.white, yloc=yloc.abovebar)
            state := 3
            if showLevels
                slLine := line.new(bar_index, slPrice, bar_index + 1, slPrice, color=color.red, style=line.style_dashed, extend=extend.right)
                tp1Line := line.new(bar_index, tp1Price, bar_index + 1, tp1Price, color=color.green, style=line.style_dotted, extend=extend.right)
                tp2Line := line.new(bar_index, tp2Price, bar_index + 1, tp2Price, color=color.green, style=line.style_dotted, extend=extend.right)
                tp3Line := line.new(bar_index, tp3Price, bar_index + 1, tp3Price, color=color.green, style=line.style_dotted, extend=extend.right)
            alert("Sideway Breakout Bot: " + (dir == 1 ? "LONG" : "SHORT") + " entry triggered", alert.freq_once_per_bar_close)
        else
            if not na(zoneBox)
                box.delete(zoneBox)
            state := 0
            lockedHigh := na
            lockedLow := na
            lockBar := na
            dir := 0
            breakoutTime := na
            zoneHigh := na
            zoneLow := na
            zoneMid := na
            touchedZone := false
            slPrice := na
            entryPrice := na
            tp1Price := na
            tp2Price := na
            tp3Price := na
            tp1Filled := false
            qtyAtEntry := na

    else if invalidated or minutesSinceBreakout > retraceTimeoutMin
        if not na(zoneBox)
            box.delete(zoneBox)
        state := 0
        lockedHigh := na
        lockedLow := na
        lockBar := na
        dir := 0
        breakoutTime := na
        zoneHigh := na
        zoneLow := na
        zoneMid := na
        touchedZone := false
        slPrice := na
        entryPrice := na
        tp1Price := na
        tp2Price := na
        tp3Price := na
        tp1Filled := false
        qtyAtEntry := na
