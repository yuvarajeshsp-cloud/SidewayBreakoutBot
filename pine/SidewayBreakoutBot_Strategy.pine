// Range detection block is adapted from LuxAlgo's "Range Detector"
// Licensed under CC BY-NC-SA 4.0: https://creativecommons.org/licenses/by-nc-sa/4.0/
// © LuxAlgo
//@version=6
// pyramiding is fixed at 10 to match "Max Concurrent Setups" max value below --
// strategy() parameters must be compile-time constants, so it can't read the input.
strategy("Sideway Breakout Bot [Strategy]", overlay=true, initial_capital=10000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=10, calc_on_every_tick=false, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ───────────────────────────── Inputs ─────────────────────────────
grpRange = "Range Detector"
rangeLength = input.int(20, "Minimum Range Length", minval=2, group=grpRange)
rangeMult   = input.float(1.0, "Range Width", minval=0, step=0.1, group=grpRange)
rangeAtrLen = input.int(500, "Range ATR Length", minval=1, group=grpRange)
upCss       = input.color(#089981, "Broken Upward", group=grpRange)
dnCss       = input.color(#f23645, "Broken Downward", group=grpRange)
unbrokenCss = input.color(#2157f3, "Unbroken", group=grpRange)
maxBarsWatch = input.int(50, "Max Bars to Wait for Breakout", minval=1, group=grpRange)
allowStackedEntries = input.bool(true, "Allow Stacked Entries", group=grpRange)
maxConcurrentSetups = input.int(3, "Max Concurrent Setups", minval=1, maxval=10, group=grpRange)

grpBreak = "Breakout"
atrLength         = input.int(14, "ATR Length (SL/Filters)", minval=1, group=grpBreak)
useBodyFilter     = input.bool(false, "Require Min Body Size", group=grpBreak)
bodyATRMult       = input.float(0.5, "Min Body Size (x ATR)", minval=0, group=grpBreak)
useFakeoutFilter  = input.bool(true, "Require Confirmation Candle After Breakout", group=grpBreak)

grpZone = "Retracement Zone"
zoneScanMaxBars  = input.int(15, "Zone Scan Lookback (bars)", minval=3, group=grpZone)
fvgMinATRMult    = input.float(0.0, "Min FVG Size (x ATR)", minval=0, group=grpZone)
retraceTimeoutMin = input.int(30, "Retracement Timeout (minutes)", minval=1, group=grpZone)

grpRisk = "Risk Management"
riskPercent     = input.float(1.0, "Risk % per Trade", minval=0.01, group=grpRisk)
slBufferATRMult = input.float(0.1, "SL Buffer (x ATR)", minval=0, group=grpRisk)

grpTP = "Take Profit"
numTPs = input.int(3, "Number of Take Profits (1-3)", minval=1, maxval=3, group=grpTP)
tp1R = input.float(1.0, "TP1 (R multiple)", minval=0.1, group=grpTP)
tp2R = input.float(2.0, "TP2 (R multiple)", minval=0.1, group=grpTP)
tp3R = input.float(3.0, "TP3 (R multiple)", minval=0.1, group=grpTP)
tp1Qty = input.float(33, "TP1 Close %", minval=1, maxval=100, group=grpTP)
tp2Qty = input.float(33, "TP2 Close %", minval=1, maxval=100, group=grpTP)
tp3Qty = input.float(34, "TP3 Close %", minval=1, maxval=100, group=grpTP)
moveToBEAfterTP1 = input.bool(true, "Move SL to Breakeven after TP1", group=grpTP)

// The last active tier always absorbs whatever % remains, so the position
// fully closes no matter how many TPs are enabled.
tp1Pct = numTPs == 1 ? 100.0 : tp1Qty
tp2Pct = numTPs == 2 ? 100.0 - tp1Qty : tp2Qty
tp3Pct = tp3Qty

grpVis = "Visuals"
showZone      = input.bool(true, "Show Retracement Zone", group=grpVis)
showLevels    = input.bool(true, "Show Entry/SL/TP Levels", group=grpVis)
showTPLabels  = input.bool(true, "Show TP1/TP2/TP3 Labels", group=grpVis)

// ───────────────────────────── Range Detector (LuxAlgo) ─────────────────────────────
var box   bx   = na
var line  lvl  = na
var float rMax = na
var float rMin = na
var int   rOs  = 0
color detect_css = na

n = bar_index
rAtr = ta.atr(rangeAtrLen) * rangeMult
ma = ta.sma(close, rangeLength)

rCount = 0
for i = 0 to rangeLength - 1
    rCount += math.abs(close[i] - ma) > rAtr ? 1 : 0

rangeEvent = rCount == 0 and rCount[1] != rCount

if rangeEvent
    if n[rangeLength] <= bx.get_right()
        rMax := math.max(ma + rAtr, bx.get_top())
        rMin := math.min(ma - rAtr, bx.get_bottom())
        bx.set_top(rMax)
        bx.set_rightbottom(n, rMin)
        bx.set_bgcolor(color.new(unbrokenCss, 80))
        avg = math.avg(rMax, rMin)
        lvl.set_y1(avg)
        lvl.set_xy2(n, avg)
        lvl.set_color(unbrokenCss)
    else
        rMax := ma + rAtr
        rMin := ma - rAtr
        bx := box.new(n[rangeLength], ma + rAtr, n, ma - rAtr, na, bgcolor=color.new(unbrokenCss, 80))
        lvl := line.new(n[rangeLength], ma, n, ma, color=unbrokenCss, style=line.style_dotted)
        detect_css := color.new(color.gray, 80)
        rOs := 0
else if rCount == 0
    bx.set_right(n)
    lvl.set_x2(n)

if close > bx.get_top()
    bx.set_bgcolor(color.new(upCss, 80))
    lvl.set_color(upCss)
    rOs := 1
else if close < bx.get_bottom()
    bx.set_bgcolor(color.new(dnCss, 80))
    lvl.set_color(dnCss)
    rOs := -1

bgcolor(detect_css)
plot(rMax, "Range Top", rMax != rMax[1] ? na : rOs == 0 ? unbrokenCss : rOs == 1 ? upCss : dnCss)
plot(rMin, "Range Bottom", rMin != rMin[1] ? na : rOs == 0 ? unbrokenCss : rOs == 1 ? upCss : dnCss)

// ───────────────────────────── Core calcs ─────────────────────────────
atrVal = ta.atr(atrLength)

// Scans the breakout leg for the nearest FVG; if none is found, falls back to
// a retracement touch of the sideways zone itself (its high/low). Returns
// [zoneHigh, zoneLow]. Read-only over outer state so it stays a plain function.
f_findZone(d, lockBarArg, lockedHighArg, lockedLowArg) =>
    scanLen = math.min(bar_index - lockBarArg, zoneScanMaxBars)
    float fH = na
    float fL = na
    bool fvgFound = false

    if scanLen >= 3
        for i = 1 to scanLen - 2
            if not fvgFound
                if d == 1
                    if low[i] > high[i + 2] and (low[i] - high[i + 2]) >= fvgMinATRMult * atrVal
                        fL := high[i + 2]
                        fH := low[i]
                        fvgFound := true
                else
                    if high[i] < low[i + 2] and (high[i + 2] - high[i]) >= fvgMinATRMult * atrVal
                        fH := low[i + 2]
                        fL := high[i]
                        fvgFound := true
                if fvgFound
                    break

    if not fvgFound
        fH := lockedHighArg
        fL := lockedLowArg

    [fH, fL]

// ───────────────────────────── Setup tracking ─────────────────────────────
// Each Setup is an independent breakout/retracement/trade lifecycle so several
// can run concurrently -- one being watched/traded no longer blocks detecting
// the next one. Each gets its own strategy order id so positions don't collide.
// state: 1 = watching for breakout, 4 = awaiting confirmation candle (fakeout
// filter), 2 = waiting for retracement confirmation, 3 = in trade
type Setup
    int    state
    float  lockedHigh
    float  lockedLow
    int    lockBar
    int    dir
    int    breakoutTime
    float  zoneHigh
    float  zoneLow
    float  zoneMid
    bool   touchedZone
    float  slPrice
    float  entryPrice
    float  tp1Price
    float  tp2Price
    float  tp3Price
    bool   tp1Filled
    float  qtyAtEntry
    string entryId
    box    zoneBox
    line   slLine
    line   tp1Line
    line   tp2Line
    line   tp3Line
    label  tp1Lbl
    label  tp2Lbl
    label  tp3Lbl

var array<Setup> setups = array.new<Setup>()
var int setupCounter = 0

// ---- Arm a new setup whenever the range detector (re)confirms a range ----
canArmNewSetup = allowStackedEntries ? array.size(setups) < maxConcurrentSetups : array.size(setups) == 0
if rangeEvent and canArmNewSetup
    array.push(setups, Setup.new(state=1, lockedHigh=rMax, lockedLow=rMin, lockBar=n, dir=0, breakoutTime=na,
         zoneHigh=na, zoneLow=na, zoneMid=na, touchedZone=false, slPrice=na, entryPrice=na,
         tp1Price=na, tp2Price=na, tp3Price=na, tp1Filled=false, qtyAtEntry=na, entryId=na,
         zoneBox=na, slLine=na, tp1Line=na, tp2Line=na, tp3Line=na, tp1Lbl=na, tp2Lbl=na, tp3Lbl=na))

// ---- Advance every active setup, one state-step per bar ----
numSetups = array.size(setups)
if numSetups > 0
    for idx = numSetups - 1 to 0
        Setup s = array.get(setups, idx)
        bool removeThis = false

        if s.state == 3
            // Find this setup's own open trade -- strategy.position_size is a
            // global total across all concurrent entries, so it can't be used
            // to tell whether THIS setup's trade has closed.
            float posSize = 0.0
            if strategy.opentrades > 0
                for ot = 0 to strategy.opentrades - 1
                    if strategy.opentrades.entry_id(ot) == s.entryId
                        posSize := strategy.opentrades.size(ot)

            if posSize == 0
                if not na(s.zoneBox)
                    box.delete(s.zoneBox)
                removeThis := true
            else
                if numTPs >= 2 and not s.tp1Filled and math.abs(posSize) <= s.qtyAtEntry * (1 - tp1Pct / 100) + 1e-8
                    s.tp1Filled := true
                    alert("Sideway Breakout Bot: TP1 hit, SL moved to breakeven", alert.freq_once_per_bar_close)

                currentStop = moveToBEAfterTP1 and s.tp1Filled ? s.entryPrice : s.slPrice
                strategy.exit("TP1_" + s.entryId, from_entry=s.entryId, qty_percent=tp1Pct, limit=s.tp1Price, stop=currentStop)
                if numTPs >= 2
                    strategy.exit("TP2_" + s.entryId, from_entry=s.entryId, qty_percent=tp2Pct, limit=s.tp2Price, stop=currentStop)
                if numTPs >= 3
                    strategy.exit("TP3_" + s.entryId, from_entry=s.entryId, qty_percent=tp3Pct, limit=s.tp3Price, stop=currentStop)

                if showLevels and not na(s.slLine)
                    line.set_y1(s.slLine, currentStop)
                    line.set_y2(s.slLine, currentStop)
                    line.set_x2(s.slLine, bar_index + 1)
                    line.set_x2(s.tp1Line, bar_index + 1)
                    line.set_x2(s.tp2Line, bar_index + 1)
                    line.set_x2(s.tp3Line, bar_index + 1)

        else if s.state == 1
            bodySize = math.abs(close - open)
            passesBody = not useBodyFilter or bodySize >= bodyATRMult * atrVal
            bullBreak = math.min(open, close) > s.lockedHigh and passesBody
            bearBreak = math.max(open, close) < s.lockedLow and passesBody

            if bullBreak or bearBreak
                s.dir := bullBreak ? 1 : -1
                s.breakoutTime := time
                if useFakeoutFilter
                    s.state := 4
                    alert("Sideway Breakout Bot: " + (bullBreak ? "bullish" : "bearish") + " breakout, awaiting confirmation candle", alert.freq_once_per_bar_close)
                else
                    [zH, zL] = f_findZone(s.dir, s.lockBar, s.lockedHigh, s.lockedLow)
                    s.zoneHigh := zH
                    s.zoneLow := zL
                    s.zoneMid := (zH + zL) / 2
                    s.touchedZone := false
                    s.state := 2
                    if showZone
                        s.zoneBox := box.new(bar_index, s.zoneHigh, bar_index, s.zoneLow, border_color=color.orange, bgcolor=color.new(color.orange, 85))
                    alert("Sideway Breakout Bot: " + (s.dir == 1 ? "bullish" : "bearish") + " breakout confirmed, zone identified", alert.freq_once_per_bar_close)
            else if bar_index - s.lockBar > maxBarsWatch
                removeThis := true

        else if s.state == 4
            bodySize4 = math.abs(close - open)
            passesBody4 = not useBodyFilter or bodySize4 >= bodyATRMult * atrVal
            confirmed = s.dir == 1 ? math.min(open, close) > s.lockedHigh and passesBody4 : math.max(open, close) < s.lockedLow and passesBody4

            if confirmed
                s.breakoutTime := time
                [zH, zL] = f_findZone(s.dir, s.lockBar, s.lockedHigh, s.lockedLow)
                s.zoneHigh := zH
                s.zoneLow := zL
                s.zoneMid := (zH + zL) / 2
                // The scanned leg spans the original breakout through this
                // confirmation candle, so it can include a pullback that
                // already reached the zone -- seed touchedZone from that
                // history instead of always starting at false.
                scanLen2 = math.max(math.min(bar_index - s.lockBar, zoneScanMaxBars), 1)
                s.touchedZone := s.dir == 1 ? ta.lowest(low, scanLen2) <= s.zoneMid : ta.highest(high, scanLen2) >= s.zoneMid
                s.state := 2
                if showZone
                    s.zoneBox := box.new(bar_index, s.zoneHigh, bar_index, s.zoneLow, border_color=color.orange, bgcolor=color.new(color.orange, 85))
                alert("Sideway Breakout Bot: " + (s.dir == 1 ? "bullish" : "bearish") + " breakout confirmed, zone identified", alert.freq_once_per_bar_close)
            else
                s.dir := 0
                s.breakoutTime := na
                s.state := 1
                alert("Sideway Breakout Bot: breakout failed confirmation (fakeout), watching for a new breakout", alert.freq_once_per_bar_close)

        else if s.state == 2
            if showZone and not na(s.zoneBox)
                box.set_right(s.zoneBox, bar_index)

            touched = s.dir == 1 ? low <= s.zoneMid : high >= s.zoneMid
            if touched
                s.touchedZone := true

            confirmBull = close > open and close > s.zoneMid
            confirmBear = close < open and close < s.zoneMid
            confirmation = s.touchedZone and (s.dir == 1 ? confirmBull : confirmBear)

            invalidated = s.dir == 1 ? close < s.lockedLow : close > s.lockedHigh
            minutesSinceBreakout = (time - s.breakoutTime) / 60000.0

            if confirmation
                s.entryPrice := close
                buffer = slBufferATRMult * atrVal
                s.slPrice := s.dir == 1 ? s.lockedLow - buffer : s.lockedHigh + buffer
                r = math.abs(s.entryPrice - s.slPrice)
                s.tp1Price := s.dir == 1 ? s.entryPrice + r * tp1R : s.entryPrice - r * tp1R
                s.tp2Price := s.dir == 1 ? s.entryPrice + r * tp2R : s.entryPrice - r * tp2R
                s.tp3Price := s.dir == 1 ? s.entryPrice + r * tp3R : s.entryPrice - r * tp3R

                riskAmount = strategy.equity * (riskPercent / 100)
                qtyToTrade = r > 0 ? riskAmount / (r * syminfo.pointvalue) : 0.0

                if qtyToTrade > 0
                    setupCounter += 1
                    s.entryId := (s.dir == 1 ? "Long_" : "Short_") + str.tostring(setupCounter)
                    s.qtyAtEntry := qtyToTrade
                    if s.dir == 1
                        strategy.entry(s.entryId, strategy.long, qty=qtyToTrade)
                        label.new(bar_index, low, "LONG ENTRY", style=label.style_label_up, color=color.green, textcolor=color.white, yloc=yloc.belowbar)
                    else
                        strategy.entry(s.entryId, strategy.short, qty=qtyToTrade)
                        label.new(bar_index, high, "SHORT ENTRY", style=label.style_label_down, color=color.red, textcolor=color.white, yloc=yloc.abovebar)
                    s.state := 3
                    if showLevels
                        s.slLine := line.new(bar_index, s.slPrice, bar_index + 1, s.slPrice, color=color.red, style=line.style_dashed, extend=extend.none)
                        s.tp1Line := line.new(bar_index, s.tp1Price, bar_index + 1, s.tp1Price, color=upCss, style=line.style_dotted, width=2)
                        if numTPs >= 2
                            s.tp2Line := line.new(bar_index, s.tp2Price, bar_index + 1, s.tp2Price, color=color.new(upCss, 30), style=line.style_dotted)
                        if numTPs >= 3
                            s.tp3Line := line.new(bar_index, s.tp3Price, bar_index + 1, s.tp3Price, color=color.new(upCss, 30), style=line.style_dotted)
                        if showTPLabels
                            s.tp1Lbl := label.new(bar_index, s.tp1Price, "TP1", style=label.style_circle, color=upCss, textcolor=color.white, size=size.normal)
                            if numTPs >= 2
                                s.tp2Lbl := label.new(bar_index, s.tp2Price, "TP2", style=label.style_circle, color=upCss, textcolor=color.white, size=size.small)
                            if numTPs >= 3
                                s.tp3Lbl := label.new(bar_index, s.tp3Price, "TP3", style=label.style_circle, color=upCss, textcolor=color.white, size=size.small)
                    alert("Sideway Breakout Bot: " + (s.dir == 1 ? "LONG" : "SHORT") + " entry triggered", alert.freq_once_per_bar_close)
                else
                    if not na(s.zoneBox)
                        box.delete(s.zoneBox)
                    removeThis := true

            else if invalidated or minutesSinceBreakout > retraceTimeoutMin
                if not na(s.zoneBox)
                    box.delete(s.zoneBox)
                removeThis := true

        if removeThis
            array.remove(setups, idx)
